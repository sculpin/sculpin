#!/usr/bin/env php
<?php

declare(strict_types=1);

function includeIfExists($file): null|\Composer\Autoload\ClassLoader
{
    return file_exists($file)
        ? include $file
        : null;
}

if (
    (!$classLoader = includeIfExists(__DIR__ . '/../vendor/autoload.php')) &&
    (!$classLoader = includeIfExists(__DIR__ . '/../../../autoload.php'))
) {
    echo 'You must set up the project dependencies, run the following commands:' . PHP_EOL .
        'curl -sS https://getcomposer.org/installer | php' . PHP_EOL .
        'php composer.phar install' . PHP_EOL;
    exit(1);
}

// Attempt to load an optional External autoloader, in case the Sculpin project
// being operated on is more advanced than the stock configuration allows.
$externalAutoloaderPath = getcwd()
    . DIRECTORY_SEPARATOR . 'vendor' . DIRECTORY_SEPARATOR . 'autoload.php';

$externalAutoloader = includeIfExists($externalAutoloaderPath);

include __DIR__ . '/sculpin.php';

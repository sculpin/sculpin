FROM alpine:3.24 AS staticphpbuilder

# Composer version
ARG SPC_COMPOSER=latest-stable

# StaticPHP 3 (spc) source
ARG SPC_REPO=https://github.com/crazywhalecc/static-php-cli
ARG SPC_REF=fix/zig-cross

# Box Project Releases: https://github.com/box-project/box/releases
ARG SPC_BOX_RELEASE=4.7.1

RUN <<-EOF
    apk update
    apk upgrade -a

    apk add --no-cache \
        autoconf \
        automake \
        gettext \
        bash \
        binutils \
        bison \
        build-base \
        cmake \
        curl \
        file \
        flex \
        g++ \
        gcc \
        git \
        gperf \
        jq \
        libgcc \
        libtool \
        libstdc++ \
        linux-headers \
        m4 \
        make \
        pkgconfig \
        re2c \
        wget \
        xz \
        gettext-dev \
        binutils-gold \
        pkgconfig \
        llvm22 \
        llvm22-dev \
        llvm22-linker-tools \
        llvm22-static \
        php85 \
        php85-common \
        php85-ctype \
        php85-dom \
        php85-fileinfo \
        php85-iconv \
        php85-mbstring \
        php85-openssl \
        php85-pcntl \
        php85-phar \
        php85-posix \
        php85-simplexml \
        php85-tokenizer \
        php85-xml \
        php85-xmlwriter
EOF

# fetch specified composer
RUN curl -#fSL "https://getcomposer.org/download/${SPC_COMPOSER}/composer.phar" -o /usr/local/bin/composer && \
    chmod +x /usr/local/bin/composer

# fetch specified version of Box
RUN curl -#fSL "https://github.com/box-project/box/releases/download/${SPC_BOX_RELEASE}/box.phar" -o /usr/local/bin/box && \
    chmod +x /usr/local/bin/box

# GNU objcopy/strip aren't multi-arch
RUN ln -sf /usr/lib/llvm22/bin/llvm-objcopy /usr/local/bin/objcopy && \
    ln -sf /usr/lib/llvm22/bin/llvm-strip /usr/local/bin/strip

RUN echo "spc ref: ${SPC_REF}" && \
    git clone --depth 1 --branch "$SPC_REF" "$SPC_REPO" /opt/spc && \
    cd /opt/spc && \
    composer install --no-dev -a && \
    printf '#!/bin/sh\nexec /usr/bin/php -d memory_limit=-1 /opt/spc/bin/spc "$@"\n' > /usr/local/bin/spc && \
    chmod +x /usr/local/bin/spc

WORKDIR /app
RUN spc install-pkg zig && spc doctor --auto-fix -vvv

COPY ./composer.* /app/
COPY ./craft.yml /app/craft.yml
COPY ./box.json.dist /app/box.json
COPY ./bin /app/bin
COPY ./src /app/src

ENV SCULPIN_STATIC_BUILDER=1
CMD ["sh", "/app/bin/static-build.sh"]
